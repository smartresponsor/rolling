{
  "name": "rolling/role",
  "description": "Rolling role Symfony bundle package",
  "type": "symfony-bundle",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "configuring/config": "dev-master",
    "cruding/crud": "dev-master",
    "doctrine/dbal": "^4.0",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.0",
    "easycorp/easyadmin-bundle": "^5.0",
    "objecting/object": "dev-master",
    "psr/simple-cache": "^3.0",
    "symfony/config": "^8.0",
    "symfony/dependency-injection": "^8.0",
    "symfony/error-handler": "^8.0",
    "symfony/event-dispatcher": "^8.0",
    "symfony/form": "^8.0",
    "symfony/framework-bundle": "^8.0",
    "symfony/http-foundation": "^8.0",
    "symfony/http-kernel": "^8.0",
    "symfony/routing": "^8.0",
    "symfony/security-csrf": "^8.0",
    "symfony/twig-bundle": "^8.0",
    "symfony/validator": "^8.0",
    "symfony/yaml": "^8.0",
    "twig/twig": "^3.24"
  },
  "require-dev": {
    "dbrekelmans/bdi": "^1.4.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "^8.0",
    "symfony/css-selector": "^8.0",
    "symfony/panther": "^2.2",
    "symfony/var-dumper": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Rolling\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Rolling\\Tests\\": "tests/",
      "Rolling\\SDK\\V2\\": "SDK/php/"
    },
    "exclude-from-classmap": [
      "tests/SDK/PHP/psr_stubs.php"
    ]
  },
  "scripts": {
    "canon:scan": "@php bin/canon-scan.php",
    "canon:namespace-audit": "@php bin/namespace-audit.php",
    "canon:no-namespace-audit": "@php bin/no-namespace-audit.php",
    "canon:autoload-audit": "@php bin/autoload-continuity-audit.php",
    "test": "vendor/bin/phpunit --configuration=phpunit.xml.dist --testsuite=unit --testdox",
    "lint": [
      "@php tools/qa/php-lint.php"
    ],
    "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G",
    "cs:check": "vendor/bin/php-cs-fixer fix --allow-risky=yes --dry-run --diff --verbose",
    "cs:fix": "vendor/bin/php-cs-fixer fix --allow-risky=yes --verbose",
    "qa": [
      "@lint",
      "@phpstan",
      "@test"
    ],
    "surface:audit": "@php tools/qa/rolling-surface-audit.php",
    "symfony81:audit": "@php tools/qa/rolling-symfony81-audit.php",
    "http-payload:audit": "@php tools/qa/rolling-http-payload-audit.php",
    "docblock:coverage": "@php tools/qa/rolling-docblock-coverage-audit.php",
    "checkbox-form:audit": "@php tools/qa/rolling-checkbox-form-audit.php",
    "cruding-resource-readiness-audit": "@php tools/qa/rolling-cruding-resource-readiness-audit.php",
    "easyadmin-surface:audit": "@php tools/qa/rolling-easyadmin-surface-audit.php",
    "objecting:adoption:audit": "@php tools/qa/rolling-objecting-adoption-audit.php",
    "solid-canon:audit": "@php tools/qa/rolling-solid-canon-audit.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../Cruding",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../Objecting",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../Configuring",
      "options": {
        "symlink": true
      }
    }
  ]
}
